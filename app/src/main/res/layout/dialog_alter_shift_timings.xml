<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/slate_900">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Alter Duty Shift Timings"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Admin can alter morning and evening shift hours depending on the nature of work assigned to employees/members."
        android:textColor="@color/slate_400"
        android:textSize="12sp"
        android:layout_marginBottom="14dp" />

    <!-- Morning Shift -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌅 Morning Shift Timing (24-hr format HH:mm)"
        android:textColor="@color/emerald_500"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/et_shift_m_start"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="Start (e.g. 09:00)"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_400"
            android:textSize="13sp"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/et_shift_m_end"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="End (e.g. 13:00)"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_400"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Evening Shift -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌆 Evening Shift Timing (24-hr format HH:mm)"
        android:textColor="@color/amber_500"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/et_shift_e_start"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="Start (e.g. 16:00)"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_400"
            android:textSize="13sp"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/et_shift_e_end"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="End (e.g. 19:00)"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_400"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
