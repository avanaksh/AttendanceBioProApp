<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_950"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header & Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_skip_top"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:background="@android:color/transparent"
                android:text="Skip →"
                android:textColor="@color/slate_400"
                android:textSize="13sp"
                android:textAllCaps="false" />

            <ImageButton
                android:id="@+id/btn_close_paywall"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/slate_400" />
        </RelativeLayout>

        <!-- Crown & Hero Heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑"
                android:textSize="42sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upgrade to Pro"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unlock unlimited logs, official audit reports, and biometric features"
                android:textColor="@color/slate_400"
                android:textSize="13sp"
                android:textAlignment="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Feature List Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_slate_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/emerald_500"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlimited Secure On-Device Duty Logs"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/emerald_500"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biometric Face and GPS Geofence Verification"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/emerald_500"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automated Excel and PDF Attendance Reports"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/emerald_500"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ad-Free Experience and 24/7 Priority Support"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Subscription Option: Annual Plan (Recommended) -->
        <LinearLayout
            android:id="@+id/card_plan_annual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_selected"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Annual Subscription"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_annual_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Billed yearly, cancel anytime"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Best Value Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_badge_gold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="SAVE 40%"
                    android:textColor="@color/slate_950"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv_annual_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$29.99 / year ($2.50/mo)"
                android:textColor="@color/indigo_500"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Subscription Option: Monthly Plan -->
        <LinearLayout
            android:id="@+id/card_plan_monthly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_unselected"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monthly Subscription"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_monthly_subtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Billed monthly, cancel anytime"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_monthly_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$4.99 / month"
                android:textColor="@color/indigo_500"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/pb_paywall_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/indigo_500"
            android:layout_marginBottom="12dp" />

        <!-- Purchase Action Button -->
        <Button
            android:id="@+id/btn_subscribe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_indigo"
            android:text="Subscribe and Unlock Pro"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <!-- Start 7-Day Free Trial (Judge / Reviewer Access) -->
        <Button
            android:id="@+id/btn_start_free_trial"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_badge_gold"
            android:text="⭐ Start 7-Day Free Trial (Judge Access)"
            android:textColor="@color/slate_950"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <!-- Redeem Promo Code Button -->
        <Button
            android:id="@+id/btn_redeem_promo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_slate_card"
            android:text="🎁 Redeem Promo Code / Judge Unlock"
            android:textColor="@color/indigo_500"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp" />

        <!-- Restore Purchases Button -->
        <Button
            android:id="@+id/btn_restore_purchases"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="Restore Purchases"
            android:textColor="@color/slate_400"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp" />

        <!-- Skip & Continue to Login Button (Requirement 5) -->
        <Button
            android:id="@+id/btn_skip_paywall"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_card_unselected"
            android:text="Skip and Continue to Login →"
            android:textColor="@color/slate_100"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp" />

        <!-- Amazon Appstore Legal & Auto-Renewal Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subscription automatically renews unless cancelled at least 24 hours before the end of the current billing cycle. You can manage or cancel your subscription at any time in Amazon Appstore Account Settings. By subscribing, you agree to our Terms of Service and Privacy Policy."
            android:textColor="@color/slate_600"
            android:textSize="10sp"
            android:textAlignment="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
