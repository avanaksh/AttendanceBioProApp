<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_slate_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_option_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Option Name / Candidate"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_option_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 votes (0%)"
            android:textColor="@color/slate_400"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_cast_option_vote"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_indigo"
        android:text="Cast Vote"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textAllCaps="false"
        android:paddingHorizontal="12dp" />

</LinearLayout>
