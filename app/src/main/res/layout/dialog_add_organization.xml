<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/slate_900">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Organization Details"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_dialog_org_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Organization Name (e.g. State Bar Council)"
        android:inputType="textCapWords"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/slate_400"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/et_dialog_org_category"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Category (e.g. Apex / Institute / Society)"
        android:inputType="textCapWords"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/slate_400"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/et_dialog_org_purpose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Voting Purpose (e.g. Cast vote for Executive Council)"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/slate_400"
        android:textSize="13sp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shift Timings"
        android:textColor="@color/slate_400"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_dialog_morning_hours"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="Morning (09:00 - 13:00)"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_400"
            android:textSize="12sp"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/et_dialog_evening_hours"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_text"
            android:hint="Evening (16:00 - 19:00)"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/white"
            android:textColorHint="@color/slate_400"
            android:textSize="12sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
